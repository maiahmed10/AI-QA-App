# Render Environment Variables Example

# Server Configuration
NODE_ENV=production
PORT=10000

# Optional Database URL (if PostgreSQL database is connected)
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# Optional JWT Secret
JWT_SECRET=your-production-super-secret-jwt-key

# Optional Remote AI MicroMind Webhook/API Key
AI_API_URL=https://dev.aimicromind.com
AI_API_KEY=your-micromind-api-key

# Client Configurable Environment Variables
VITE_API_URL=/api
VITE_QA_WEBHOOK_URL=/api/v1/ai/qa-analyze
VITE_API_ENDPOINT=/api/messages
